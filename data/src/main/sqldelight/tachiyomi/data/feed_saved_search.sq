-- SY-specific file

import kotlin.Boolean;

CREATE TABLE feed_saved_search (
    _id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    saved_search INTEGER,
    global INTEGER AS Boolean NOT NULL,
    feed_order INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(saved_search) REFERENCES saved_search (_id)
    ON DELETE CASCADE
);

CREATE INDEX feed_saved_search_saved_search_index ON feed_saved_search(saved_search);

selectAllGlobal:
SELECT _id, source, saved_search, global, feed_order
FROM feed_saved_search
WHERE global = 1
ORDER BY feed_order;

countGlobal:
SELECT count(*)
FROM feed_saved_search
WHERE global = 1;

selectBySource:
SELECT _id, source, saved_search, global, feed_order
FROM feed_saved_search
WHERE source = :sourceId
AND global = 0
ORDER BY feed_order;

insertReturningId:
INSERT INTO feed_saved_search(source, saved_search, global, feed_order)
VALUES (:source, :savedSearch, :global, (SELECT COALESCE(MAX(feed_order), 0) + 1 FROM feed_saved_search))
RETURNING _id;

insert:
INSERT INTO feed_saved_search(source, saved_search, global, feed_order)
VALUES (:source, :savedSearch, :global, (SELECT COALESCE(MAX(feed_order), 0) + 1 FROM feed_saved_search));

deleteById:
DELETE FROM feed_saved_search
WHERE _id = :id;

deleteAll:
DELETE FROM feed_saved_search;

selectGlobalFeedSavedSearch:
SELECT S._id, S.source, S.name, S.query, S.filters_json
FROM feed_saved_search F
JOIN saved_search S
ON S._id = F.saved_search
WHERE F.global = 1
ORDER BY F.feed_order;

selectSourceFeedSavedSearch:
SELECT S._id, S.source, S.name, S.query, S.filters_json
FROM feed_saved_search F
JOIN saved_search S
ON S._id = F.saved_search
WHERE F.global = 0
AND F.source = :sourceId
ORDER BY F.feed_order;

countSourceFeedSavedSearch:
SELECT count(*)
FROM feed_saved_search F
JOIN saved_search S
ON S._id = F.saved_search
WHERE F.global = 0
AND F.source = :sourceId;

selectAllFeedWithSavedSearchName:
SELECT coalesce(f.source, s.source) source, f.global, s.name
FROM feed_saved_search AS f
LEFT JOIN saved_search AS s
ON f.saved_search = s._id
ORDER BY f.feed_order;

getGlobalFeedIds:
SELECT _id
FROM feed_saved_search
WHERE global = 1
ORDER BY feed_order;

getSourceFeedIds:
SELECT _id
FROM feed_saved_search
WHERE source = :sourceId
AND global = 0
ORDER BY feed_order;

updateOrder:
UPDATE feed_saved_search
SET feed_order = :order
WHERE _id = :id;
